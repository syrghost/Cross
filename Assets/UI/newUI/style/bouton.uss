.bouton {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    -unity-font-style: bold;
    font-size: 10px;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgba(49, 164, 160, 0);
    white-space: nowrap;
    text-shadow: 10px 10px 0 rgba(13, 200, 30, 0);
    background-color: rgb(180, 77, 67);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    -unity-navigation-mode: vertical;
}

.bouton:hover {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    -unity-font-style: bold;
    font-size: 10px;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgba(245, 245, 245, 0);
    white-space: nowrap;
    text-shadow: 10px 10px 0 rgba(13, 200, 30, 0);
    background-color: rgb(83, 180, 67);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-width: 3px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    transition-timing-function: ease-in-elastic;
    transition-duration: 0.1s;
}

.bouton:focus {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    -unity-font-style: bold;
    font-size: 10px;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgba(245, 245, 245, 0);
    white-space: nowrap;
    text-shadow: 10px 10px 0 rgba(13, 200, 30, 0);
    background-color: rgb(83, 180, 67);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-width: 3px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    transition-timing-function: ease-in-elastic;
    transition-duration: 0.1s;
}
